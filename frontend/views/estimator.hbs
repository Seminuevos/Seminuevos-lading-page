        }

        .btn-print-quote:hover {
            background: rgba(255, 255, 255, 0.12);
            border-color: rgba(255, 255, 255, 0.25);
        }

        .legal-notice {
            margin-top: 10px;
            font-size: 0.68rem;
            color: #64748b;
            line-height: 1.35;
            text-align: center;
        }

        /* Cash Mode View */
        .cash-mode-content {
            display: none;
        }

        /* Printable Sheet Hidden by Default */
        #printableQuoteSheet {
            display: none;
        }

        /* Print Media Styles */
        @media print {
            body * {
                visibility: hidden;
            }
            #printableQuoteSheet, #printableQuoteSheet * {
                visibility: visible;
            }
            #printableQuoteSheet {
                display: block !important;
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                background: #ffffff;
                color: #111111;
                padding: 40px;
            }
            .navbar, .footer, .social-sidebar, .whatsapp-float {
                display: none !important;
            }
        }
