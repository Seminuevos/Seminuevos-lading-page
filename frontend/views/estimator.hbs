            const initDisbEl = document.getElementById('printInitialDisbursement');
            if (initDisbEl) {
                initDisbEl.textContent = `$${initialDisbursement.toLocaleString()}`;
            }

            document.getElementById('printPrincipal').textContent = `$${Math.round(princ).toLocaleString()}`;
            document.getElementById('printTermApr').textContent = `${loanTermMonths} Meses • Perfil: ${getCreditScoreName()}`;
            document.getElementById('printInterest').textContent = `$${Math.round(amort.totalInterest).toLocaleString()}`;

            if (currentPaymentType === 'finance') {
                document.getElementById('printMonthly').textContent = `$${Math.round(amort.monthly).toLocaleString()} / mes`;
            } else {
                document.getElementById('printMonthly').textContent = `$${(carPrice - (tradeInActive ? tradeInValue : 0)).toLocaleString()} (Contado)`;
            }

            window.print();
        }

        function initEstimator() {
            recalculate();
            initCustomSelect();
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initEstimator);
        } else {
            initEstimator();
        }

        // Global exports for inline HTML handlers
        window.switchEstimatorMode = switchEstimatorMode;
        window.toggleCustomPriceMode = toggleCustomPriceMode;
        window.onCustomPriceInput = onCustomPriceInput;
        window.onVehicleSelectChange = onVehicleSelectChange;
        window.selectVehicleById = selectVehicleById;
        window.setPaymentType = setPaymentType;
        window.setDownPaymentPct = setDownPaymentPct;
        window.onDownPaymentSliderChange = onDownPaymentSliderChange;
        window.setLoanTerm = setLoanTerm;
        window.setCreditScoreTier = setCreditScoreTier;
        window.onCreditScoreSliderChange = onCreditScoreSliderChange;
        window.setMonthlyRate = setMonthlyRate;
        window.onRateSliderChange = onRateSliderChange;
        window.toggleFormalizationFees = toggleFormalizationFees;
        window.toggleFormalizationDetailsCollapse = toggleFormalizationDetailsCollapse;
        window.onFeeInputsChange = onFeeInputsChange;
        window.resetFormalizationFees = resetFormalizationFees;
        window.toggleTradeIn = toggleTradeIn;
        window.calculateTradeInLive = calculateTradeInLive;
        window.onTradeInManualOverride = onTradeInManualOverride;
        window.onBudgetSliderChange = onBudgetSliderChange;
        window.setBudgetPreset = setBudgetPreset;
        window.printQuoteSheet = printQuoteSheet;
        window.recalculate = recalculate;
    </script>
</body>
</html>
