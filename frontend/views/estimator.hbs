            font-weight: 700;
            border-radius: 12px;
            text-decoration: none;
            transition: all 0.3s ease;
            box-shadow: 0 4px 20px rgba(37, 211, 102, 0.3);
            margin-bottom: 8px;
            border: none;
            cursor: pointer;
        }

        .btn-whatsapp-quote:hover {
            background: #22c35e;
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(37, 211, 102, 0.45);
            color: #000;
        }

        .btn-print-quote {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            padding: 9px 14px;
