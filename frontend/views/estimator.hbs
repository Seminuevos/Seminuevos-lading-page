        // --- MATHEMATICAL ENGINE (Fórmula Francesa de Amortización con Tasa Mensual) ---
        function calculateAmortization(principal, monthlyRatePct, months) {
            if (principal <= 0 || months <= 0) return { monthly: 0, totalInterest: 0, totalPaid: 0 };
            const i = (monthlyRatePct / 100);
            if (i === 0) {
                const m = principal / months;
                return { monthly: m, totalInterest: 0, totalPaid: principal };
            }
            const factor = Math.pow(1 + i, months);
            const monthly = principal * (i * factor) / (factor - 1);
            const totalPaid = monthly * months;
            const totalInterest = Math.max(0, totalPaid - principal);
            return { monthly, totalInterest, totalPaid };
        }

        // Reverse formula: Calculate max principal from target monthly payment
        function calculatePrincipalFromMonthly(monthly, monthlyRatePct, months) {
            if (monthly <= 0 || months <= 0) return 0;
            const i = (monthlyRatePct / 100);
            if (i === 0) return monthly * months;
            const factor = Math.pow(1 + i, months);
            return monthly * (factor - 1) / (i * factor);
        }

        // --- MAIN RECALCULATE ---
        function recalculate() {
            let effectivePrice = 0;
            let effectiveTradeIn = 0;
            let netCarPrice = 0;
            let downPaymentAmount = 0;
            let principal = 0;
            let amort = { monthly: 0, totalInterest: 0, totalPaid: 0 };

            const anosPlazo = loanTermMonths / 12;
            const gpsTotal = feeGpsAnual * anosPlazo;
            const seguroTotal = feeSeguroAnual * anosPlazo;
            const totalFees = feeGastosAdmin + feeNotariaPlacas + gpsTotal + seguroTotal;

            if (currentMode === 'budget') {
                // Cálculo para Modo Presupuesto Mensual
                const maxPrincipal = calculatePrincipalFromMonthly(targetMonthlyBudget, monthlyRate, loanTermMonths);
                const maxPriceAfterTrade = maxPrincipal / (1 - (downPaymentPct / 100));
                const maxTotalCarPrice = Math.round(maxPriceAfterTrade + (tradeInActive ? tradeInValue : 0));

                effectivePrice = maxTotalCarPrice;
                effectiveTradeIn = tradeInActive ? Math.min(effectivePrice, Math.max(0, tradeInValue)) : 0;
                netCarPrice = Math.max(0, effectivePrice - effectiveTradeIn);
                downPaymentAmount = Math.round(netCarPrice * (downPaymentPct / 100));
                principal = Math.max(0, netCarPrice - downPaymentAmount);
                amort = calculateAmortization(principal, monthlyRate, loanTermMonths);

                // Sincronizar display de poder de compra en Modo 2
                const bpPriceEl = document.getElementById('bpCalculatedPrice');
                if (bpPriceEl) bpPriceEl.textContent = `$${effectivePrice.toLocaleString()}`;

                // Sincronizar mini breakdown del card de presupuesto
                const bpDown = document.getElementById('bpMiniDown');
                if (bpDown) bpDown.textContent = `$${downPaymentAmount.toLocaleString()}`;
                const bpDownPct = document.getElementById('bpMiniDownPct');
                if (bpDownPct) bpDownPct.textContent = `${downPaymentPct}% del valor`;
                const bpPrinc = document.getElementById('bpMiniPrincipal');
                if (bpPrinc) bpPrinc.textContent = `$${Math.round(principal).toLocaleString()}`;
                const bpTerm = document.getElementById('bpMiniTerm');
                if (bpTerm) bpTerm.textContent = `${loanTermMonths} cuotas fijas`;

                // Header y montos en columna derecha
                document.getElementById('mainResultTitle').textContent = 'Cuota Mensual Objetivo';
                document.getElementById('mainPaymentDisplay').innerHTML = `$ ${targetMonthlyBudget.toLocaleString()} <span class="sum-period">/ mes</span>`;
                document.getElementById('mainPaymentSubtext').textContent = `Poder de compra: $${effectivePrice.toLocaleString()} • ${loanTermMonths} cuotas fijas • Perfil: ${getCreditScoreName()}`;
                
                const carPriceLabel = document.querySelector('#rowCarPrice')?.previousElementSibling;
                if (carPriceLabel) carPriceLabel.textContent = 'Poder de Compra Estimado';
            } else {
                // Modo 1: Estimar por Vehículo
                effectivePrice = Math.max(0, carPrice);
                effectiveTradeIn = tradeInActive ? Math.min(effectivePrice, Math.max(0, tradeInValue)) : 0;
                netCarPrice = Math.max(0, effectivePrice - effectiveTradeIn);
                downPaymentAmount = Math.round(netCarPrice * (downPaymentPct / 100));
                principal = Math.max(0, netCarPrice - downPaymentAmount);
                amort = calculateAmortization(principal, monthlyRate, loanTermMonths);

                const carPriceLabel = document.querySelector('#rowCarPrice')?.previousElementSibling;
                if (carPriceLabel) carPriceLabel.textContent = 'Precio del Vehículo';

                if (currentPaymentType === 'finance') {
                    document.getElementById('mainResultTitle').textContent = 'Cuota Mensual Estimada';
                    document.getElementById('mainPaymentDisplay').innerHTML = `$ ${Math.round(amort.monthly).toLocaleString()} <span class="sum-period">/ mes</span>`;
                    document.getElementById('mainPaymentSubtext').textContent = `Estimado a ${loanTermMonths} cuotas fijas · Perfil: ${getCreditScoreName()}`;
                } else {
                    document.getElementById('mainResultTitle').textContent = 'Pago de Contado Neto';
                    document.getElementById('mainPaymentDisplay').innerHTML = `$ ${(effectivePrice - effectiveTradeIn).toLocaleString()}`;
                    document.getElementById('mainPaymentSubtext').textContent = (tradeInActive && effectiveTradeIn > 0)
                        ? `Precio lista $${effectivePrice.toLocaleString()} menos $${effectiveTradeIn.toLocaleString()} de retoma evaluada`
                        : `Monto final neto para entrega o importación directa`;
                }
            }

            const initialDisbursement = downPaymentAmount + (includeFormalizationFees ? totalFees : 0);

            // Update subtotal bar & detail labels
            const elFeeSubtotal = document.getElementById('feeSubtotalSum');
            if (elFeeSubtotal) elFeeSubtotal.textContent = `$${Math.round(totalFees).toLocaleString()}`;
            const elFeeNote = document.getElementById('feeGpsCalcNote');
            if (elFeeNote) elFeeNote.textContent = `(GPS $${feeGpsAnual}/año + Seguro $${feeSeguroAnual}/año × ${anosPlazo} ${anosPlazo === 1 ? 'año' : 'años'} = $${Math.round(gpsTotal + seguroTotal).toLocaleString()})`;
            const elQuickBadge = document.getElementById('feeQuickTotalBadge');
            if (elQuickBadge) {
                elQuickBadge.textContent = includeFormalizationFees 
                    ? `($${Math.round(totalFees).toLocaleString()} est.)` 
                    : '(Desactivado)';
            }

            // UI Updates - Sliders and labels
            const elDownDisp = document.getElementById('downPaymentDisplay');
            if (elDownDisp) elDownDisp.textContent = `$${downPaymentAmount.toLocaleString()} (${downPaymentPct}%)`;

            const elTermDisp = document.getElementById('termDisplay');
            if (elTermDisp) elTermDisp.textContent = `${loanTermMonths} Meses (${anosPlazo.toFixed(1).replace('.0', '')} Años)`;

            const elCreditDisp = document.getElementById('creditScoreDisplay');
            if (elCreditDisp) elCreditDisp.textContent = getCreditScoreName();

            // Breakdown table rows
            document.getElementById('rowCarPrice').textContent = `$${effectivePrice.toLocaleString()}`;

            const trRow = document.getElementById('rowTradeInWrap');
            if (tradeInActive && effectiveTradeIn > 0) {
                trRow.style.display = 'flex';
                document.getElementById('rowTradeInValue').textContent = `-$${effectiveTradeIn.toLocaleString()}`;
            } else {
                trRow.style.display = 'none';
            }

            const netRow = document.getElementById('rowNetCarWrap');
            if (tradeInActive && effectiveTradeIn > 0 && currentPaymentType === 'finance') {
                netRow.style.display = 'flex';
                document.getElementById('rowNetCar').textContent = `$${netCarPrice.toLocaleString()}`;
            } else {
                netRow.style.display = 'none';
            }

            document.getElementById('rowDownPayment').textContent = `-$${downPaymentAmount.toLocaleString()}`;

            const feesRow = document.getElementById('rowFeesWrap');
            const initDisbRow = document.getElementById('rowInitialDisbursementWrap');
            if (currentPaymentType === 'finance') {
                if (includeFormalizationFees) {
                    feesRow.style.display = 'flex';
                    document.getElementById('rowFees').textContent = `+$${totalFees.toLocaleString()}`;
                    initDisbRow.style.display = 'flex';
                    document.getElementById('rowInitialDisbursement').textContent = `$${initialDisbursement.toLocaleString()}`;
                } else {
                    feesRow.style.display = 'none';
                    initDisbRow.style.display = 'flex';
                    document.getElementById('rowInitialDisbursement').textContent = `$${downPaymentAmount.toLocaleString()}`;
                }
            } else {
                feesRow.style.display = 'none';
                initDisbRow.style.display = 'none';
            }

            document.getElementById('rowPrincipal').textContent = `$${Math.round(principal).toLocaleString()}`;
            const elRateVal = document.getElementById('rowRateVal');
            if (elRateVal) elRateVal.textContent = '';
            document.getElementById('rowInterest').textContent = `$${Math.round(amort.totalInterest).toLocaleString()}`;

            if (currentPaymentType === 'finance') {
                const totalInvestment = initialDisbursement + effectiveTradeIn + amort.totalPaid;
                document.getElementById('rowTotalAmount').textContent = `$${Math.round(totalInvestment).toLocaleString()}`;

                // Proportional bar
                const totalBar = downPaymentAmount + principal + amort.totalInterest;
                if (totalBar > 0) {
                    const pctDown = (downPaymentAmount / totalBar) * 100;
                    const pctPrinc = (principal / totalBar) * 100;
                    const pctInt = (amort.totalInterest / totalBar) * 100;

                    document.getElementById('propSegDown').style.width = pctDown + '%';
                    document.getElementById('propSegPrincipal').style.width = pctPrinc + '%';
                    document.getElementById('propSegInterest').style.width = pctInt + '%';

                    document.getElementById('legDown').textContent = `$${downPaymentAmount.toLocaleString()}`;
                    document.getElementById('legPrincipal').textContent = `$${Math.round(principal).toLocaleString()}`;
                    document.getElementById('legInterest').textContent = `$${Math.round(amort.totalInterest).toLocaleString()}`;
                }
            } else {
                const cashTotal = effectivePrice - effectiveTradeIn;
                document.getElementById('rowTotalAmount').textContent = `$${cashTotal.toLocaleString()}`;
            }

            // WhatsApp link generation
            buildWhatsAppLink(effectivePrice, effectiveTradeIn, downPaymentAmount, totalFees, initialDisbursement, principal, amort);
        }

        // --- BUYING POWER CALCULATIONS & COMPATIBLE CARS ---
        function updateBudgetCompatibleCars() {
            // Reverse principal using monthly rate
            const maxPrincipal = calculatePrincipalFromMonthly(targetMonthlyBudget, monthlyRate, loanTermMonths);
            const maxPriceAfterTrade = maxPrincipal / (1 - (downPaymentPct / 100));
            const maxTotalCarPrice = Math.round(maxPriceAfterTrade + (tradeInActive ? tradeInValue : 0));

            const bpPriceEl = document.getElementById('bpCalculatedPrice');
            if (bpPriceEl) {
                bpPriceEl.textContent = `$${maxTotalCarPrice.toLocaleString()}`;
            }

            // Filter vehicles
            const container = document.getElementById('compatCarsContainer');
            if (!container) return;
            container.innerHTML = '';

            const qualifying = estimatorInventory.filter(car => car.price <= (maxTotalCarPrice * 1.05)); // 5% flexibility

            const countEl = document.getElementById('compatCount');
            if (countEl) countEl.textContent = `${qualifying.length} vehículos`;

            const quickEl = document.getElementById('compatCountQuick');
            if (quickEl) quickEl.textContent = `Ver ${qualifying.length} vehículos que califican abajo`;

            if (qualifying.length === 0) {
                container.innerHTML = `
                    <div style="grid-column: 1/-1; padding: 30px; text-align: center; color: #94a3b8; background: rgba(255,255,255,0.02); border-radius: 12px;">
                        <i class="fas fa-search" style="font-size: 1.8rem; margin-bottom: 10px; color: #64748b;"></i>
                        <p>No encontramos vehículos con una cuota tan baja. Prueba aumentando el presupuesto a partir de $350/mes o ajustando el inicial.</p>
                    </div>
                `;
                return;
            }

            qualifying.forEach(car => {
                const pAfterTr = Math.max(0, car.price - (tradeInActive ? tradeInValue : 0));
                const dwn = pAfterTr * (downPaymentPct / 100);
                const princ = Math.max(0, pAfterTr - dwn);
                const am = calculateAmortization(princ, monthlyRate, loanTermMonths);
                const mQuote = Math.round(am.monthly);

                const card = document.createElement('div');
                card.className = `compat-car-card ${selectedVehicle && selectedVehicle.id === car.id ? 'selected-in-grid' : ''}`;
                const thumb = (car.images && car.images.length > 0) ? car.images[0] : 'images/logo-white.png';

                card.innerHTML = `
                    <img src="${thumb}" alt="${car.title}" class="compat-car-img" loading="lazy">
                    <div class="compat-car-body">
                        <div class="compat-car-title">${car.title}</div>
                        <div class="compat-car-price">Precio: $${car.price.toLocaleString()}</div>
                        <div class="compat-car-payment-tag">~$${mQuote} / mes</div>
                    </div>
                `;

                card.onclick = () => {
                    selectVehicleById(car.id);
                    switchEstimatorMode('vehicle');
                    window.scrollTo({ top: 80, behavior: 'smooth' });
                };

                container.appendChild(card);
            });
        }

