    <!-- ===== ESTIMATOR LOGIC SCRIPT ===== -->
    <script>
        // Global state (scoped to estimator)
        let estimatorInventory = [];
        let currentMode = 'vehicle'; // 'vehicle' | 'budget'
        let currentPaymentType = 'finance'; // 'finance' | 'cash'
        let isCustomPrice = false;

        let selectedVehicle = null;
        let carPrice = 36000;
        let downPaymentPct = 30; // Aligned with Admin recommendation (30%)
        let loanTermMonths = 36;
        let monthlyRate = 1.5; // Aligned with Admin Tier 1 (1.5% mensual)
        let aprRate = 18; // 1.5 * 12
        let tradeInActive = false;
        let tradeInValue = 0;
        let targetMonthlyBudget = 350;

        // Formalization & Protection fees (Aligned with calcularCreditoPlan() in admin.html - Customizable)
        let includeFormalizationFees = true;
        let feeGastosAdmin = 350;
        let feeNotariaPlacas = 450;
        let feeGpsAnual = 180;
        let feeSeguroAnual = 600;
        let isFormalizationDetailsOpen = false;

        // Trade-In condition diagnostics state (Aligned with calculateTradeIn() in admin.html)
        let tradeInDiagnostic = {
            model: '',
            year: 2017,
            km: 85000,
            trans: 'Automática',
            marketPrice: 8500,
            repairCost: 0,
            condMech: 'bueno',
            condEsthet: 'bueno',
            condElec: 'bueno'
        };

        function formatVehicleRecord(v) {
            return {
                id: v.id,
                title: v.title || 'Vehículo',
                price: parseNumberPrice(v.price),
                rawPrice: v.price,
                year: v.year || '',
                km: v.km || v.mileage || '',
                engine: v.engine || '',
                transmission: v.transmission || '',
                condition: v.condition || 'seminuevo',
                origin: v.origin || 'nacional',
                badge: v.badge || '',
                images: Array.isArray(v.images) ? v.images : (v.images ? [v.images] : ['images/logo-white.png'])
            };
        }

        function getInitialVehicles() {
            try {
                const raw = localStorage.getItem('sn_supabase_cache');
                if (raw) {
                    const parsed = JSON.parse(raw);
                    if (parsed && parsed.vehicles && parsed.vehicles.length > 0) {
                        return parsed.vehicles.map(formatVehicleRecord).filter(v => v.price > 0);
                    }
                }
            } catch (e) {}

            const staticSeminuevos = (typeof vehiclesSeminuevos !== 'undefined') ? vehiclesSeminuevos : [];
            const static0km = (typeof vehicles0km !== 'undefined') ? vehicles0km : [];
            return [...staticSeminuevos, ...static0km].map(formatVehicleRecord).filter(v => v.price > 0);
        }

        // --- BOOTSTRAP & INVENTORY LOADING ---
        function bootEstimator() {
            const navToggle = document.getElementById('navToggle');
            const navMenu = document.getElementById('navMenu');
            navToggle?.addEventListener('click', () => {
                navToggle.classList.toggle('active');
                navMenu?.classList.toggle('active');
            });

            // 1. Inicialización instantánea síncrona (0ms de latencia)
            estimatorInventory = getInitialVehicles();
            if (estimatorInventory.length > 0) {
                const urlParams = new URLSearchParams(window.location.search);
                const carIdParam = urlParams.get('id') || urlParams.get('carId');
                const modeParam = urlParams.get('mode');
                populateVehicleSelect(carIdParam);
                if (modeParam === 'budget') {
                    switchEstimatorMode('budget');
                } else {
                    updateBudgetCompatibleCars();
                    recalculate();
                }
            }

            // 2. Sincronización en segundo plano con Supabase
            syncSupabaseInventory();
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', bootEstimator);
        } else {
            bootEstimator();
        }

        async function syncSupabaseInventory() {
            try {
                const timeoutPromise = new Promise((_, reject) => setTimeout(() => reject(new Error('timeout')), 3500));
                const fetchPromise = apiFetch('/api/public/vehicles');

                const res = await Promise.race([fetchPromise, timeoutPromise]);
                const data = res?.ok ? res.data?.data : null;
                if (data && data.length > 0) {
                    const freshList = data.map(formatVehicleRecord).filter(v => v.price > 0);
                    if (freshList.length > 0) {
                        const currentId = selectedVehicle ? selectedVehicle.id : null;
                        estimatorInventory = freshList;
                        populateVehicleSelect(currentId);
                        updateBudgetCompatibleCars();
                    }
                }
            } catch (e) {
                console.warn('Background Supabase sync notice:', e);
            }
        }

        function parseNumberPrice(str) {
            if (typeof str === 'number') return str;
            if (!str) return 0;
            const cleaned = String(str).replace(/[^0-9]/g, '');
            return parseInt(cleaned, 10) || 0;
        }

        function populateVehicleSelect(preferredId) {
            const sel = document.getElementById('vehicleSelect');
            if (!sel) return;
            sel.innerHTML = '';

            if (estimatorInventory.length === 0) {
                sel.innerHTML = '<option value="">No hay vehículos disponibles</option>';
                return;
            }

            estimatorInventory.forEach((car) => {
                const opt = document.createElement('option');
                opt.value = car.id;
                opt.textContent = `${car.title} - $${car.price.toLocaleString()}`;
                sel.appendChild(opt);
            });

            const targetId = preferredId || (estimatorInventory[0] ? estimatorInventory[0].id : null);
            if (targetId) {
                selectVehicleById(targetId);
            }
        }

        function selectVehicleById(id) {
            const car = estimatorInventory.find(v => String(v.id) === String(id));
            if (!car) return;

            selectedVehicle = car;
            carPrice = car.price;
            isCustomPrice = false;

            document.getElementById('customPriceContainer').style.display = 'none';
            document.getElementById('vehiclePreviewBox').style.display = 'flex';
            document.getElementById('vehicleSelect').value = car.id;
            document.getElementById('customPriceBtnText').textContent = 'Precio Manual';

            // Update UI card
            document.getElementById('selCarTitle').textContent = car.title;
            document.getElementById('selCarPrice').textContent = `$${car.price.toLocaleString()}`;
            document.getElementById('selCarMeta').textContent = `${car.year || '2024'} • ${car.km || 'Bajo KM'} • ${car.transmission || 'Automático'}`;
            document.getElementById('selCarCondition').textContent = (car.condition === '0km') ? '0KM' : 'Seminuevo';
            document.getElementById('selCarOrigin').textContent = (car.origin === 'nacional') ? 'Nacional' : 'Puerto Libre';
            
            const firstImg = (car.images && car.images.length > 0) ? car.images[0] : 'images/logo-white.png';
            document.getElementById('selCarImg').src = firstImg;

            const viewDetailsLink = document.getElementById('selCarViewDetails');
            if (viewDetailsLink) {
                viewDetailsLink.href = `vehiculo.html?id=${car.id}`;
                viewDetailsLink.style.display = 'inline-flex';
            }

            recalculate();
        }

        function onVehicleSelectChange() {
            const sel = document.getElementById('vehicleSelect');
            selectVehicleById(sel.value);
        }

        // --- MODE SWITCHER ---
        function switchEstimatorMode(mode) {
            currentMode = mode;
            const btnV = document.getElementById('btnModeVehicle');
            const btnB = document.getElementById('btnModeBudget');
            const secV = document.getElementById('modeVehicleSection');
            const secB = document.getElementById('modeBudgetSection');
            const secCompat = document.getElementById('budgetCompatibleSection');
            const gridEl = document.getElementById('estimatorGrid');
            const sumCol = document.getElementById('summaryColumn');

            if (mode === 'vehicle') {
                btnV.classList.add('active');
                btnB.classList.remove('active');
                secV.style.display = 'block';
                secB.style.display = 'none';
                if (gridEl) gridEl.classList.remove('budget-mode-active');
                if (sumCol) sumCol.style.display = 'block';
                if (secCompat) secCompat.style.display = 'none';
            } else {
                btnB.classList.add('active');
                btnV.classList.remove('active');
                secB.style.display = 'block';
                secV.style.display = 'none';
                if (gridEl) gridEl.classList.add('budget-mode-active');
                if (sumCol) sumCol.style.display = 'none';
                if (secCompat) secCompat.style.display = 'block';
                updateBudgetCompatibleCars();
            }
            recalculate();
        }

        // --- CUSTOM PRICE TOGGLE ---
        function toggleCustomPriceMode() {
            isCustomPrice = !isCustomPrice;
            const box = document.getElementById('customPriceContainer');
            const btnText = document.getElementById('customPriceBtnText');
            const preview = document.getElementById('vehiclePreviewBox');
            const viewDetailsLink = document.getElementById('selCarViewDetails');

            if (isCustomPrice) {
                box.style.display = 'block';
                btnText.textContent = 'Ver Lista de Autos';
                if (viewDetailsLink) viewDetailsLink.style.display = 'none';
                const input = document.getElementById('customPriceInput');
                input.value = carPrice;
                input.focus();
            } else {
                box.style.display = 'none';
                btnText.textContent = 'Precio Manual';
                if (viewDetailsLink) viewDetailsLink.style.display = 'inline-flex';
                if (selectedVehicle) {
                    carPrice = selectedVehicle.price;
                }
            }
            recalculate();
        }

        function onCustomPriceInput() {
            const val = parseFloat(document.getElementById('customPriceInput').value) || 0;
            carPrice = Math.max(0, val);
            recalculate();
        }

        // --- PAYMENT TYPE (FINANCE VS CASH) ---
        function setPaymentType(type) {
            currentPaymentType = type;
            const tabF = document.getElementById('tabFinancing');
            const tabC = document.getElementById('tabCash');
            const wrapF = document.getElementById('financeParametersWrap');
            const wrapC = document.getElementById('cashParametersWrap');
            const trTitle = document.getElementById('tradeInTitle');
            const trSub = document.getElementById('tradeInSubtitle');

            if (type === 'finance') {
                tabF.classList.add('active');
                tabC.classList.remove('active');
                wrapF.style.display = 'block';
                wrapC.style.display = 'none';
                document.getElementById('propBarWrap').style.display = 'block';
                document.getElementById('rowPrincipalWrap').style.display = 'flex';
                document.getElementById('rowInterestWrap').style.display = 'flex';
                document.getElementById('rowDownPaymentWrap').style.display = 'flex';
                document.getElementById('mainResultTitle').textContent = 'Cuota Mensual Estimada';
                document.getElementById('rowTotalLabel').textContent = 'Total Inversión Proyectada';
                if (trTitle) trTitle.textContent = '¿Entregas tu auto actual como parte de pago? (Trade-In)';
                if (trSub) trSub.textContent = 'Diagnóstico técnico y tasación basada en el estado real de tu vehículo.';
            } else {
                tabC.classList.add('active');
                tabF.classList.remove('active');
                wrapF.style.display = 'none';
                wrapC.style.display = 'block';
                document.getElementById('propBarWrap').style.display = 'none';
                document.getElementById('rowPrincipalWrap').style.display = 'none';
                document.getElementById('rowInterestWrap').style.display = 'none';
                document.getElementById('rowDownPaymentWrap').style.display = 'none';
                document.getElementById('rowFeesWrap').style.display = 'none';
                document.getElementById('rowInitialDisbursementWrap').style.display = 'none';
                document.getElementById('mainResultTitle').textContent = 'Pago de Contado Neto';
                document.getElementById('rowTotalLabel').textContent = 'Total a Desembolsar';
                if (trTitle) trTitle.textContent = '¿Entregas tu auto actual a cambio?';
                if (trSub) trSub.textContent = 'Descontamos el valor de retoma del precio de contado.';
            }
            recalculate();
        }

        // --- CONTROLS EVENT HANDLERS ---
        function setDownPaymentPct(pct) {
            downPaymentPct = pct;
            const slider = document.getElementById('downPaymentSlider');
            if (slider) slider.value = pct;
            highlightPreset('downPaymentSlider', pct);
            recalculate();
        }

        function onDownPaymentSliderChange(val) {
            downPaymentPct = parseInt(val, 10);
            highlightPreset('downPaymentSlider', downPaymentPct);
            recalculate();
        }

        function setLoanTerm(months) {
            loanTermMonths = months;
            highlightPillByText(months + ' Meses');
            recalculate();
        }

        // --- EST. CREDIT SCORE ENGINE (Sincronizado con Mesa de Crédito) ---
        const creditScoreTiers = {
            'excelente': {
                name: 'Excelente (720+)',
                rate: 1.5,
                color: '#6ee7b7',
                border: 'rgba(16, 185, 129, 0.4)',
                bg: 'rgba(16, 185, 129, 0.15)',
                sliderVal: 1,
                warning: false
            },
            'bueno': {
                name: 'Bueno (660-719)',
                rate: 2.0,
                color: '#93c5fd',
                border: 'rgba(39, 92, 234, 0.4)',
                bg: 'rgba(39, 92, 234, 0.15)',
                sliderVal: 2,
                warning: false
            },
            'aceptable': {
                name: 'Aceptable (580-659)',
                rate: 2.5,
                color: '#fde047',
                border: 'rgba(234, 179, 8, 0.4)',
                bg: 'rgba(234, 179, 8, 0.15)',
                sliderVal: 3,
                warning: false
            },
            'construccion': {
                name: 'En Construcción (520-579)',
                rate: 3.0,
                color: '#f87171',
                border: 'rgba(239, 68, 68, 0.4)',
                bg: 'rgba(239, 68, 68, 0.15)',
                sliderVal: 4,
                warning: true
            }
        };

        let currentCreditTier = 'excelente';

        function setCreditScoreTier(tierKey) {
            const tier = creditScoreTiers[tierKey] || creditScoreTiers['excelente'];
            currentCreditTier = tierKey;
            monthlyRate = tier.rate;
            aprRate = monthlyRate * 12;

            const disp = document.getElementById('creditScoreDisplay');
            if (disp) {
                disp.textContent = tier.name;
                disp.style.color = tier.color;
                disp.style.borderColor = tier.border;
                disp.style.background = tier.bg;
            }

            const slider = document.getElementById('creditScoreSlider');
            if (slider) slider.value = tier.sliderVal;

            const pills = document.querySelectorAll('#creditScorePills .preset-pill');
            pills.forEach((p, idx) => {
                if (idx + 1 === tier.sliderVal) {
                    p.classList.add('active');
                } else {
                    p.classList.remove('active');
                }
            });

            const warn = document.getElementById('creditScoreWarning');
            if (warn) {
                warn.style.display = tier.warning ? 'flex' : 'none';
            }

            recalculate();
        }

        function onCreditScoreSliderChange(val) {
            const v = parseInt(val, 10);
            const keys = ['excelente', 'bueno', 'aceptable', 'construccion'];
            const chosenKey = keys[v - 1] || 'excelente';
            setCreditScoreTier(chosenKey);
        }

        function getCreditScoreName() {
            return creditScoreTiers[currentCreditTier]?.name || 'Excelente (720+)';
        }

        function setMonthlyRate(rate) {
            if (rate <= 1.6) setCreditScoreTier('excelente');
            else if (rate <= 2.1) setCreditScoreTier('bueno');
            else if (rate <= 2.6) setCreditScoreTier('aceptable');
            else setCreditScoreTier('construccion');
        }

        function onRateSliderChange(val) {
            setMonthlyRate(parseFloat(val));
        }

        function toggleFormalizationDetailsCollapse(forceOpen) {
            if (typeof forceOpen === 'boolean') {
                isFormalizationDetailsOpen = forceOpen;
            } else {
                isFormalizationDetailsOpen = !isFormalizationDetailsOpen;
            }
            const el = document.getElementById('formalizationCollapsible');
            const txt = document.getElementById('txtToggleFormalizationDetails');
            const icon = document.getElementById('iconToggleFormalizationDetails');
            if (el) {
                el.style.display = isFormalizationDetailsOpen ? 'block' : 'none';
            }
            if (txt) {
                txt.textContent = isFormalizationDetailsOpen ? 'Ocultar detalles' : 'Ver detalles';
            }
            if (icon) {
                icon.style.transform = isFormalizationDetailsOpen ? 'rotate(180deg)' : 'rotate(0deg)';
            }
        }

        function toggleFormalizationFees(forceState) {
            if (typeof forceState === 'boolean') {
                includeFormalizationFees = forceState;
            } else {
                includeFormalizationFees = !includeFormalizationFees;
            }
            const chk = document.getElementById('includeFeesCheck');
            if (chk) chk.checked = includeFormalizationFees;
            const card = document.getElementById('formalizationCard');
            if (card) {
                card.classList.toggle('fees-inactive', !includeFormalizationFees);
            }
            recalculate();
        }

        function onFeeInputsChange() {
            feeGastosAdmin = Math.max(0, parseFloat(document.getElementById('inputFeeAdmin')?.value) || 0);
            feeNotariaPlacas = Math.max(0, parseFloat(document.getElementById('inputFeeNotaria')?.value) || 0);
            feeGpsAnual = Math.max(0, parseFloat(document.getElementById('inputFeeGps')?.value) || 0);
            feeSeguroAnual = Math.max(0, parseFloat(document.getElementById('inputFeeSeguro')?.value) || 0);
            recalculate();
        }

        function resetFormalizationFees() {
            feeGastosAdmin = 350;
            feeNotariaPlacas = 450;
            feeGpsAnual = 180;
            feeSeguroAnual = 600;
            const inAdmin = document.getElementById('inputFeeAdmin');
            if (inAdmin) inAdmin.value = 350;
            const inNotaria = document.getElementById('inputFeeNotaria');
            if (inNotaria) inNotaria.value = 450;
            const inGps = document.getElementById('inputFeeGps');
            if (inGps) inGps.value = 180;
            const inSeguro = document.getElementById('inputFeeSeguro');
            if (inSeguro) inSeguro.value = 600;
            recalculate();
        }

        // --- TECHNICAL TRADE-IN AVALÚO ENGINE (Sincronizado con admin.html) ---
        function toggleTradeIn(forceState) {
            if (typeof forceState === 'boolean') {
                tradeInActive = forceState;
            } else {
                tradeInActive = !tradeInActive;
            }
            const chk = document.getElementById('tradeInCheck');
            if (chk) chk.checked = tradeInActive;
            const chkCash = document.getElementById('tradeInCheckCash');
            if (chkCash) chkCash.checked = tradeInActive;

            const form = document.getElementById('tradeInForm');
            if (form) form.style.display = tradeInActive ? 'block' : 'none';

            if (tradeInActive) {
                calculateTradeInLive();
            } else {
                tradeInValue = 0;
                recalculate();
            }
        }

        function calculateTradeInLive() {
            const model = document.getElementById('tradeInModel')?.value.trim() || 'Auto en Retoma';
            const year = parseInt(document.getElementById('tradeInYear')?.value) || new Date().getFullYear();
            const km = parseInt(document.getElementById('tradeInKm')?.value) || 0;
            const trans = document.getElementById('tradeInTrans')?.value || 'Automática';
            const marketPrice = parseFloat(document.getElementById('tradeInMarketPrice')?.value) || 0;
            const repairCost = parseFloat(document.getElementById('tradeInRepairCost')?.value) || 0;
            const cMech = document.getElementById('tradeInCondMech')?.value || 'bueno';
            const cEsthet = document.getElementById('tradeInCondEsthet')?.value || 'bueno';
            const cElec = document.getElementById('tradeInCondElec')?.value || 'bueno';

            tradeInDiagnostic = {
                model,
                year,
                km,
                trans,
                marketPrice,
                repairCost,
                condMech: cMech,
                condEsthet: cEsthet,
                condElec: cElec
            };

            // 1. Promediación por tramos de Año (Fórmula oficial admin.html)
            let pMin = marketPrice * 0.85;
            let pMax = marketPrice * 1.15;
            let pAvg = marketPrice;
            if (marketPrice > 0) {
                if (year >= 2011 && year <= 2017) {
                    pAvg = pMin + (pMax - pMin) * 0.60;
                } else if (year >= 2018 && year <= 2023) {
                    pAvg = pMin + (pMax - pMin) * 0.75;
                } else if (year >= 2024) {
                    pAvg = pMax;
                }
            }

            // 2. Factor por Kilometraje (Tabla oficial de admin.html)
            let kmFactor = 1.0;
            if (year >= 2024) {
                kmFactor = 1.0;
            } else {
                if (km <= 50000) {
                    kmFactor = 0.95;
                } else if (km <= 100000) {
                    kmFactor = 0.88;
                } else if (km <= 150000) {
                    kmFactor = 0.80;
                } else {
                    kmFactor = 0.70;
                }
            }

            // 3. Ponderación por Condición (Mecánica 50%, Estética 30%, Electrónica 20%)
            const weights = { bueno: 1.0, regular: 0.92, grave: 0.80 };
            const condFactor = ((weights[cMech] || 1.0) * 0.50) + ((weights[cEsthet] || 1.0) * 0.30) + ((weights[cElec] || 1.0) * 0.20);

            // Badges en UI
            const bMech = document.getElementById('badgeMech');
            if (bMech) bMech.textContent = `${((weights[cMech] || 1.0) * 100).toFixed(0)}%`;
            const bEst = document.getElementById('badgeEsthet');
            if (bEst) bEst.textContent = `${((weights[cEsthet] || 1.0) * 100).toFixed(0)}%`;
            const bElec = document.getElementById('badgeElec');
            if (bElec) bElec.textContent = `${((weights[cElec] || 1.0) * 100).toFixed(0)}%`;

            // 4. Algoritmo de Recepción Trade-In (Margen comercial de seguridad 12%)
            const baseValue = pAvg * kmFactor * condFactor;
            const marginRatio = 0.88; // 12% margen de retoma de Seminuevos
            let calculatedTradeIn = (baseValue - repairCost) * marginRatio;
            const floorMin = pMin * 0.40;
            if (calculatedTradeIn < floorMin) calculatedTradeIn = floorMin;
            if (calculatedTradeIn < 0) calculatedTradeIn = 0;

            // Check manual override
            const overrideInput = document.getElementById('tradeInValueOverride');
            let effectiveVal = calculatedTradeIn;
            if (overrideInput && overrideInput.value !== '' && !isNaN(parseFloat(overrideInput.value))) {
                effectiveVal = Math.max(0, parseFloat(overrideInput.value));
            }

            tradeInValue = Math.round(effectiveVal);

            // Actualizar Display en el formulario de retoma
            const elDisp = document.getElementById('tradeInCalculatedDisplay');
            if (elDisp) elDisp.textContent = `$ ${Math.round(calculatedTradeIn).toLocaleString()}`;

            const elDetail = document.getElementById('tradeInFactorsDetail');
            if (elDetail) {
                elDetail.innerHTML = `Condición: <b>${(condFactor * 100).toFixed(0)}%</b> • Ajuste KM: <b>${(kmFactor * 100).toFixed(0)}%</b> • Margen Seminuevos: <b>12%</b>`;
            }

            recalculate();
        }

