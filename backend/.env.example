# Backend API — Variables de entorno
# Copia como .env para desarrollo local. NUNCA subas .env real a git.

PORT=3001

# ========================
# SUPABASE
# ========================
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_publica
# Clave privada, acceso total a la DB — SOLO en el backend, nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# ========================
# JWT — OBLIGATORIO, sin valor por defecto
# ========================
# Genera una clave real con: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ========================
# CORS
# ========================
# Lista separada por comas de orígenes permitidos (el frontend Nest, por ejemplo)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ========================
# INTEGRACIONES (antes vivían, mal, en site_settings — nunca en el frontend)
# ========================
# Resend: usado por POST /api/email/send (reemplaza a api/send-email.js)
RESEND_API_KEY=
RESEND_FROM_EMAIL=SemiNuevo Agency <onboarding@resend.dev>

# Apify: proxy residencial para el importador de subastas (reemplaza a api/scrape.js).
# Opcional — sin ella, el scraper solo funciona con fetch directo (sin bypass anti-bot).
APIFY_API_KEY=
