# Backend API — Variables de entorno
# Copia como .env para desarrollo local. NUNCA subas .env real a git.

PORT=3001

# ========================
# SUPABASE
# ========================
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_publica
# Clave privada, acceso total a la DB — SOLO en el backend, nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# ========================
# JWT — OBLIGATORIO, sin valor por defecto
# ========================
# Genera una clave real con: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ========================
# CORS
# ========================
# Lista separada por comas de orígenes permitidos (el frontend Nest, por ejemplo)
CORS_ALLOWED_ORIGINS=http://localhost:3000
