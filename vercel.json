{
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
        { "source": "/admin",                 "destination": "/404", "permanent": false },
        { "source": "/admin.html",            "destination": "/404", "permanent": false },
        { "source": "/Admin",                 "destination": "/404", "permanent": false },
        { "source": "/administrador",         "destination": "/404", "permanent": false },
        { "source": "/dashboard",             "destination": "/404", "permanent": false },
        { "source": "/cms",                   "destination": "/404", "permanent": false },
        { "source": "/wp-admin",              "destination": "/404", "permanent": false },
        { "source": "/wp-admin/:path*",       "destination": "/404", "permanent": false },
        { "source": "/login",                 "destination": "/404", "permanent": false },
        { "source": "/panel",                 "destination": "/404", "permanent": false },
        { "source": "/admin/:path*",          "destination": "/404", "permanent": false },
        { "source": "/acceso-personal",       "destination": "/404", "permanent": false },
        { "source": "/acceso-personal.html",  "destination": "/404", "permanent": false },
        { "source": "/mt-operaciones",        "destination": "/404", "permanent": false },
        { "source": "/mt-operaciones.html",   "destination": "/404", "permanent": false }
    ],
    "rewrites": [
        { "source": "/SM-OP", "destination": "/sm-op" },
        { "source": "/SM-op", "destination": "/sm-op" },
        { "source": "/sm-OP", "destination": "/sm-op" }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "X-Frame-Options",         "value": "DENY" },
                { "key": "X-XSS-Protection",        "value": "1; mode=block" },
                { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" }
            ]
        },
        {
            "source": "/SM-OP",
            "headers": [
                { "key": "X-Robots-Tag",  "value": "noindex, nofollow, noarchive, nosnippet" },
                { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
            ]
        },
        {
            "source": "/sm-op",
            "headers": [
                { "key": "X-Robots-Tag",  "value": "noindex, nofollow, noarchive, nosnippet" },
                { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
            ]
        },
        {
            "source": "/sm-op.html",
            "headers": [
                { "key": "X-Robots-Tag",  "value": "noindex, nofollow, noarchive, nosnippet" },
                { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
            ]
        }
    ]
}