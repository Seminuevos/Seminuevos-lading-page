# Variables de Entorno — Seminuevos API
# Copia este archivo como .env para desarrollo local (NUNCA subas .env a git)
# Configura estas variables en Vercel Dashboard → Settings → Environment Variables

# ========================
# SUPABASE — SERVIDOR
# ========================
# URL de tu proyecto Supabase (visible en Settings → API)
SUPABASE_URL=https://gfvmugsbizmvlziljxir.supabase.co

# Clave ANON (pública, solo lectura según RLS — se puede exponer en el frontend)
SUPABASE_ANON_KEY=sb_publishable_g0Iw9r4zRCBadMPtiF5kNA_x8_n4p8v

# Clave SERVICE ROLE (privada, acceso total a la DB — NUNCA en el frontend)
# Obtenerla en: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# ========================
# AUTENTICACIÓN JWT
# ========================
# Clave secreta para firmar tokens JWT (generar con: openssl rand -base64 64)
JWT_SECRET=cambia_esto_por_una_clave_aleatoria_larga_y_segura_de_al_menos_64_caracteres

# ========================
# CORS — DOMINIO PERMITIDO
# ========================
# El dominio exacto de tu frontend en Vercel (sin slash final)
# En producción: https://seminuevoautos.com
# En desarrollo: * (permite todos)
API_ALLOWED_ORIGIN=https://seminuevoautos.com

# ========================
# TESTS (solo para CI/local)
# ========================
# URL base de la API para los tests de integración
TEST_API_BASE=http://localhost:3000
# Credenciales de un usuario de prueba para los tests con DB real
# TEST_WITH_DB=true
# TEST_USER_EMAIL=tu_usuario_de_prueba@email.com
# TEST_USER_PASSWORD=tu_password_de_prueba
